{
  "name": "heterotopia-visual-novel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-story.mjs && tsc -b && vite build && node scripts/write-sw-manifest.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "portable": "node scripts/build-portable.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/with-preview.mjs scripts/test-browser.mjs",
    "test:interactions": "node --import tsx scripts/with-preview.mjs scripts/test-interactions.mjs",
    "test:sprites": "node --import tsx scripts/with-preview.mjs scripts/test-sprites.mjs",
    "test:perf": "node --import tsx scripts/with-preview.mjs scripts/perf-sprites.mjs",
    "test:portable": "node --import tsx scripts/test-portable.mjs",
    "test:audio": "node --import tsx scripts/with-preview.mjs scripts/test-audio.mjs",
    "test:ui-polish": "node --import tsx scripts/with-preview.mjs scripts/test-ui-polish.mjs",
    "test:reading-audio": "node --import tsx scripts/with-preview.mjs scripts/test-reading-audio.mjs",
    "art:compress": "python scripts/build-images.py",
    "fonts:prepare": "node scripts/prepare-story.mjs && python scripts/prepare_fonts.py",
    "assets:check": "node --import tsx scripts/check-assets.mjs",
    "test:cache": "node scripts/test-cache.mjs",
    "test:assets": "node scripts/with-preview.mjs scripts/test-assets.mjs",
    "test:cgs": "node --import tsx scripts/with-preview.mjs scripts/test-cg-layouts.mjs",
    "test:actor-variants": "node --import tsx scripts/with-preview.mjs scripts/test-actor-variants.mjs",
    "art:originals": "python scripts/encode-originals.py",
    "import:story": "python scripts/import_story.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.56.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
