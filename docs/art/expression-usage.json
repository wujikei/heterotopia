  "missingPortraitSpeakers": [
    {
      "speaker": "王",
      "pages": 6,
      "first": "A-4:6:0",
      "examples": [
        {
          "id": "A-4:6:0",
          "text": "不知道！不知道还一遍遍来叫寡人知道！"
        },
        {
          "id": "A-4:9:0",
          "text": "巫呢。来卜。"
        },
        {
          "id": "A-4:11:0",
          "text": "那个，抬头。"
        }
      ],
      "blocks": 6
    },
    {
      "speaker": "魏叔",
      "pages": 5,
      "first": "B-9-1:4:0",
      "examples": [
        {
          "id": "B-9-1:4:0",
          "text": "吃了没？"
        },
        {
          "id": "B-9-1:9:0",
          "text": "这个时节种，开春才吃得上。"
        },
        {
          "id": "B-9-1:13:0",
          "text": "那我再看。搁袋里，它也不会自己长。"
        }
      ],
      "blocks": 5
    },
    {
      "speaker": "父亲",
      "pages": 4,
      "first": "0-8:19:0",
      "examples": [
        {
          "id": "0-8:19:0",
          "text": "辞伢，链条买好了。这回回来给你换。别推着坏车乱跑，晓得不？"
        },
        {
          "id": "终-4:4:0",
          "text": "说修车，拖这么久。你怪我晚了没？"
        },
        {
          "id": "终-4:8:0",
          "text": "可说了回来，就该有个信。夜里再睡不着，你给我留话，停车了我听。"
        }
      ],
      "blocks": 4
    },
    {
      "speaker": "甲士",
      "pages": 4,
      "first": "1-11:7:0",
      "examples": [
        {
          "id": "1-11:7:0",
          "text": "屈公递了免行书。人我带走。"
        },
        {
          "id": "1-11:11:0",
          "text": "能等一夜。免书在路上，他若肯上车，我带他走，后头有屈公。"
        },
        {
          "id": "1-11:16:0",
          "text": "查籍已经查到这儿。后面还会来人。"
        }
      ],
      "blocks": 4
    },
    {
      "speaker": "先王之声",
      "pages": 4,
      "first": "A-6:16:0",
      "examples": [
        {
          "id": "A-6:16:0",
          "text": "他长高了么？"
        },
        {
          "id": "A-8:12:0",
          "text": "犹。"
        },
        {
          "id": "A-8:15:0",
          "text": "你在门外，为什么不应？"
        }
      ],
      "blocks": 4
    },
    {
      "speaker": "老卒",
      "pages": 4,
      "first": "A-E2-2:5:0",
      "examples": [
        {
          "id": "A-E2-2:5:0",
          "text": "别听了。"
        },
        {
          "id": "A-E2-2:7:0",
          "text": "新的人正接各门。再过一更，这纸未必认了。"
        },
        {
          "id": "A-E2-2:10:0",
          "text": "少记一个。"
        }
      ],
      "blocks": 4
    },
    {
      "speaker": "先王之魂",
      "pages": 4,
      "first": "A-H-1:6:0",
      "examples": [
        {
          "id": "A-H-1:6:0",
          "text": "戌呢？"
        },
        {
          "id": "A-H-1:12:0",
          "text": "衡还在拿别人替自己走。"
        },
        {
          "id": "A-H-1:16:0",
          "text": "你已经知道了。"
        }
      ],
      "blocks": 4
    },
    {
      "speaker": "老渡人",
      "pages": 4,
      "first": "B-6:7:0",
      "examples": [
        {
          "id": "B-6:7:0",
          "text": "去年秋天酿的，等我儿回来。封泥都等裂了，再留，真叫坛子自己喝了。"
        },
        {
          "id": "B-6:12:0",
          "text": "老巫右脚年轻时折过，脚趾合不拢。四年前，我还给他配过鞋。"
        },
        {
          "id": "B-6:14:0",
          "text": "沉江祠的老祝见过。明早我送，今夜别拆，先把人看住。"
        }
      ],
      "blocks": 4
    },
    {
      "speaker": "阿豆",
      "pages": 4,
      "first": "B-9-4:4:0",
      "examples": [
        {
          "id": "B-9-4:4:0",
          "text": "你们要拿什么？"
        },
        {
          "id": "B-9-4:6:0",
          "text": "我阿娘找水去了。"
        },
        {
          "id": "B-9-4:10:0",
          "text": "船去哪儿？"
        }
      ],
      "blocks": 4
    },
    {
      "speaker": "陈野",
      "pages": 3,
      "first": "0-5:6:0",
      "examples": [
        {
          "id": "0-5:6:0",
          "text": "小辞！对不住，真没看见！来打一会儿不？"
        },
        {
          "id": "0-5:8:0",
          "text": "你最近怎么了？蔫得跟被食堂煮过一遍似的。"
        },
        {
          "id": "0-5:10:0",
          "text": "那更该来，输球也怪运气，稳赚！"
        }
      ],
      "blocks": 3
    },
    {
      "speaker": "梦中少年",
      "pages": 2,
      "first": "0-7:9:0",
      "examples": [
        {
          "id": "0-7:9:0",
          "text": "别……"
        },
        {
          "id": "0-11:16:0",
          "text": "别……松。"
        }
      ],
      "blocks": 2
    },
    {
      "speaker": "护祭人",
      "pages": 2,
      "first": "A-E3-2:4:0",
      "examples": [
        {
          "id": "A-E3-2:4:0",
          "text": "等等。"
        },
        {
          "id": "A-E3-2:8:0",
          "text": "家里……还有两个孩子。"
        }
      ],
      "blocks": 2
    },
    {
      "speaker": "新娘母亲",
      "pages": 2,
      "first": "B-4:5:0",
      "examples": [
        {
          "id": "B-4:5:0",
          "text": "甲都混着穿。火一起，顾不上认了。"
        },
        {
          "id": "B-4:9:0",
          "text": "日子去年就挑好了。房子烧了，日子又没烧。"
        }
      ],
      "blocks": 2
    },
    {
      "speaker": "守妻老人",
      "pages": 2,
      "first": "B-5-2:7:0",
      "examples": [
        {
          "id": "B-5-2:7:0",
          "text": "她还听得见么？"
        },
        {
          "id": "B-5-6:4:0",
          "text": "我不懂那些名目。水分开，不乱碰，我们记得。"
        }
      ],
      "blocks": 2
    },
    {
      "speaker": "老祝",
      "pages": 2,
      "first": "B-7-1:6:0",
      "examples": [
        {
          "id": "B-7-1:6:0",
          "text": "这具身子，是前些日子收的一个亡人，没人认领。我见过左眼角那颗痣。巫阳的名字，借在他身上了。"
        },
        {
          "id": "B-7-2:9:0",
          "text": "这几年，朝外求得多，对身旁说得少，连泥人都给摆忘了。"
        }
      ],
      "blocks": 2
    },
    {
      "speaker": "梦中人",
      "pages": 1,
      "first": "0-1:4:0",
      "examples": [
        {
          "id": "0-1:4:0",
          "text": "这个呢？"
        }
      ],
      "blocks": 1
    },
    {
      "speaker": "司机",
      "pages": 1,
      "first": "0-3:19:0",
      "examples": [
        {
          "id": "0-3:19:0",
          "text": "别挤！轮胎出了点事，都先坐好！"
        }
      ],
      "blocks": 1
    },
    {
      "speaker": "英语老师",
      "pages": 1,
      "first": "0-4:4:0",
      "examples": [
        {
          "id": "0-4:4:0",
          "text": "既然这么精神，沈辞，你来翻译。"
        }
      ],
      "blocks": 1
    },
    {
      "speaker": "林薇",
      "pages": 1,
      "first": "0-4:6:0",
      "examples": [
        {
          "id": "0-4:6:0",
          "text": "你今天也太倒霉了吧。要不去归元寺拜一拜？"
        }
      ],
      "blocks": 1
    },
    {
      "speaker": "老巫者",
      "pages": 1,
      "first": "0-7:4:0",
      "examples": [
        {
          "id": "0-7:4:0",
          "text": "魂兮归来……去君之恒干，何为四方些？"
        }
      ],
      "blocks": 1
    },
    {
      "speaker": "妇人",
      "pages": 1,
      "first": "1-4:5:0",
      "examples": [
        {
          "id": "1-4:5:0",
          "text": "今日去，祭肉分你一份。明日换了人，可没这个数。"
        }
      ],
      "blocks": 1
    },
    {
      "speaker": "太后",
      "pages": 1,
      "first": "A-4:19:0",
      "examples": [
        {
          "id": "A-4:19:0",
          "text": "礼官用的人，礼官管。别吓坏了，大祭还要用。"
        }
      ],
      "blocks": 1
    },
