    {
      "id": "0-3:20:0",
      "sceneId": "0-3",
      "speaker": "宋嘉树",
      "mood": "惊魂未定",
      "direction": "",
      "expression": "surprised",
      "portraitExpression": "default",
      "displayedExpression": "default",
      "cg": null,
      "stage": "song",
      "annotated": false,
      "text": "我靠，你这个运气还带群体伤害的？"
    },
    {
      "id": "0-6:9:0",
      "sceneId": "0-6",
      "speaker": "沈辞",
      "mood": "",
      "direction": "沈辞停住。身后饭店的油锅响了一下。",
      "expression": "surprised",
      "portraitExpression": "surprised",
      "displayedExpression": "surprised",
      "cg": null,
      "stage": "shen",
      "annotated": true,
      "text": "……谁跟你说的？"
    },
    {
      "id": "0-8:24:0",
      "sceneId": "0-8",
      "speaker": "沈辞",
      "mood": "",
      "direction": "",
      "expression": "angry",
      "portraitExpression": "angry",
      "displayedExpression": "angry",
      "cg": null,
      "stage": "shen",
      "annotated": true,
      "text": "跟他说又能怎么样。能回来替我上课？"
    },
    {
      "id": "1-2:9:0",
      "sceneId": "1-2",
      "speaker": "阿媪",
      "mood": "",
      "direction": "阿媪把柴放下，手指点在船边一团歪斜的线条上。",
      "expression": "smile",
      "portraitExpression": "smile",
      "displayedExpression": "smile",
      "cg": null,
      "stage": "amao",
      "annotated": true,
      "text": "五岁画的。非说是凤凰。你看这翅膀，鸡都嫌短，还不许人笑。"
    },
    {
      "id": "1-5:18:0",
      "sceneId": "1-5",
      "speaker": "阿媪",
      "mood": "",
      "direction": "",
      "expression": "sad",
      "portraitExpression": "sad",
      "displayedExpression": "sad",
      "cg": null,
      "stage": "amao",
      "annotated": true,
      "text": "你三岁。给宫里织布，咳了一个冬天。"
    },
    {
      "id": "1-7:7:0",
      "sceneId": "1-7",
      "speaker": "阿媪",
      "mood": "笑了一下",
      "direction": "",
      "expression": "smile",
      "portraitExpression": "smile",
      "displayedExpression": "smile",
      "cg": null,
      "stage": "amao",
      "annotated": false,
      "text": "阿禾。小时候这么叫。长大了不让喊，嫌像没断奶。"
    },
    {
      "id": "1-12:11:0",
      "sceneId": "1-12",
      "speaker": "阿媪",
      "mood": "",
      "direction": "沈辞低头，看袖口的靛青布。阿媪伸手，把他包着伤的掌心翻过来。",
      "expression": "sad",
      "portraitExpression": "sad",
      "displayedExpression": "sad",
      "cg": null,
      "stage": "amao",
      "annotated": true,
      "text": "可我跟他们说，没用。你也听见了。"
    },
    {
      "id": "A-1:16:0",
      "sceneId": "A-1",
      "speaker": "屈衡",
      "mood": "",
      "direction": "",
